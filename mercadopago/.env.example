# ==========================================================================
# CREDENCIAIS DO MERCADO PAGO  —  arquivo secreto
# --------------------------------------------------------------------------
# 1. copie este arquivo:   cp .env.example .env
# 2. cole o Access Token abaixo
# 3. NUNCA envie o .env para o GitHub (ele já está no .gitignore)
#
# Onde pegar: https://www.mercadopago.com.br/developers/panel/app
#             Suas integrações > sua aplicação > Credenciais
#
# Comece com as credenciais de TESTE (começam com TEST-).
# Só troque pelas de produção (APP_USR-) quando estiver tudo certo.
# ==========================================================================

MP_ACCESS_TOKEN=COLE_AQUI_SEU_ACCESS_TOKEN

# Porta do servidor (opcional)
PORT=3000

# Endereço público do webhook (opcional, só funciona com o site publicado)
# MP_WEBHOOK_URL=https://seudominio.com.br/api/mercadopago/webhook
